# Copy to backend/.env and fill in your key. Everything else has a default.

# Required for ASR, chat and TTS. Without it the app boots and serves the UI,
# but /api/health reports openai_configured:false and model calls return 503.
OPENAI_API_KEY=

# Optional: point the SDK at a proxy or an Azure/compatible gateway.
OPENAI_BASE_URL=

# Optional: send chat completions (answers, query rewrite, ingest enrichment)
# to DeepSeek instead. Embeddings, ASR and TTS still use OPENAI_API_KEY. With
# this set the default BOOKTALK_LLM_MODEL becomes deepseek-chat — so leave
# BOOKTALK_LLM_MODEL unset below (or set it to a DeepSeek model).
# BOOKTALK_CHAT_API_KEY / BOOKTALK_CHAT_BASE_URL do the same for any other
# OpenAI-compatible chat provider.
DEEPSEEK_API_KEY=

# Optional: public-demo guard rails — per-IP rate limits, and the books present
# at boot cannot be deleted. The Docker image turns this on.
BOOKTALK_DEMO=0

# Models (see SPEC §2). The ASR and TTS models fall back to whisper-1 / tts-1
# automatically if the configured model is unavailable on your account.
BOOKTALK_LLM_MODEL=gpt-4o-mini
BOOKTALK_ASR_MODEL=gpt-4o-mini-transcribe
BOOKTALK_TTS_MODEL=gpt-4o-mini-tts
BOOKTALK_TTS_VOICE=alloy
BOOKTALK_EMBED_MODEL=text-embedding-3-small

# Upload limit in megabytes, and where the SQLite file and PDFs are kept.
BOOKTALK_MAX_UPLOAD_MB=200
BOOKTALK_DATA_DIR=./data

# Optional: one extra gpt-4o-mini call to rerank the top 8 chunks before
# answering. Off by default because it delays the first spoken word.
BOOKTALK_RERANK=0

# Contextual retrieval (SPEC §14.4): one short gpt-4o-mini call per chunk at
# ingest time, writing the sentence that says where the chunk sits in its
# chapter. On by default — it costs ingest time and tokens, not answer latency.
# Set to 0 to index the static breadcrumb header instead (the eval's arm B).
BOOKTALK_CONTEXTUAL=1

# Retrieval tuning (SPEC §14.6). k is the RRF constant — 60 comes from
# million-document TREC corpora, one book wants the small-corpus range — and
# the two weights scale the dense and BM25 legs of the fusion. These are the
# starting point of the eval sweep, not a measured optimum.
BOOKTALK_RRF_K=20
BOOKTALK_DENSE_WEIGHT=0.5
BOOKTALK_BM25_WEIGHT=0.5

# Cross-encoder rerank over the fused head: a 5 MB ONNX model, ~8 ms for 20
# passages, downloaded once into $BOOKTALK_DATA_DIR/flashrank. On by default;
# set to 0 to run on fusion order alone (the app degrades to that on its own
# if the model cannot be loaded). The model is fetched on a background thread
# at startup, and only when OPENAI_API_KEY is set — an app with no key makes
# no network calls at all. Until it lands, and whenever it is off, the
# `confidence` field of the SSE `sources` event is a normalized fused rank
# rather than an absolute score, so it reads 1.0 for anything that matched.
BOOKTALK_FLASHRANK=1
BOOKTALK_FLASHRANK_MODEL=ms-marco-TinyBERT-L-2-v2

# Optional: comma-separated CORS origins (default: the Vite dev server), and a
# directory of built frontend assets to serve from /.
BOOKTALK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BOOKTALK_STATIC_DIR=
